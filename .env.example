# 로컬 기본값을 바꾸고 싶을 때만 이 파일을 복사해 .env를 만들고 값을 수정하세요. (cp .env.example .env)
# .env가 없으면 compose.yaml에 정의된 로컬 개발 전용 기본값이 사용됩니다.
# .env는 Git에 커밋되지 않습니다.

# MySQL root 계정 비밀번호 (관리용, 애플리케이션에서는 사용하지 않음)
MYSQL_ROOT_PASSWORD=local-root-password

# 애플리케이션 전용 계정 (ticketing DB에 대한 권한만 부여됨)
MYSQL_USER=ticketing_app
MYSQL_PASSWORD=local-app-password

# 참고: 이 파일은 Docker Compose만 읽습니다. Spring Boot는 .env를 읽지 않으므로
# 위 값을 기본값과 다르게 바꿨다면 IntelliJ Run Configuration 등에
# DB_USERNAME(= MYSQL_USER), DB_PASSWORD(= MYSQL_PASSWORD)를 같은 값으로 설정해야 합니다.
# 자세한 내용은 docs/개발환경.md를 참고하세요.
