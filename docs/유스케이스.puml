
@startuml
left to right direction
skin rose
skinparam packageStyle rectangle
skinparam nodesep 25
skinparam ranksep 120

actor "비회원" as Guest
actor "회원" as Member
actor "관리자" as Admin

rectangle "티켓팅 시스템" {
    package "회원 관리" {
        usecase "이메일 중복 확인" as UC1
        usecase "이메일 회원 가입" as UC2
        usecase "로그인" as UC3
    }

    package "공연 관리" {
        usecase "예약 가능한 공연 목록 조회" as UC4
        usecase "전체 공연 목록 조회" as UC5
        usecase "공연 상세 조회" as UC6
        usecase "공연 등록" as UC7
        usecase "공연 정보 수정" as UC8
    }

    package "예약 관리" {
        usecase "예약 신청" as UC9
        usecase "예약 목록 조회" as UC10
        usecase "예약 상세 조회" as UC11
        usecase "예약 취소" as UC12
    }

    package "결제 관리" {
        usecase "결제" as UC13
    }
}

Guest --> UC1 #green
Guest --> UC2 #green
Guest --> UC3 #green
Guest --> UC4 #green
Guest --> UC5 #green
Guest --> UC6 #green

Member --> UC4 #blue
Member --> UC5 #blue
Member --> UC6 #blue
Member --> UC9 #blue
Member --> UC10 #blue
Member --> UC11 #blue
Member --> UC12 #blue
Member --> UC13 #blue

Admin --> UC7 #black
Admin --> UC8 #black
Admin --|> Member

@enduml
